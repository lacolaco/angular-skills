{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // TypeScript 6 no longer pulls in @types/* automatically.
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["tools/**/*.ts"]
}
